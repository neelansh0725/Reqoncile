# Copy to .env and fill in. .env is gitignored.
#
# BACKEND ONLY. Nothing in this file belongs to the frontend or to Vercel.
# Vercel's import scan reads this file from the repo root even when the Root
# Directory is set to frontend/, and will offer GOOGLE_API_KEY as a frontend
# variable. Decline it. The frontend's own variables are in
# frontend/.env.example, and only VITE_-prefixed names are ever needed there.
#
# Reqoncile splits model usage into two TIERS. Each tier is (provider, model),
# so re-pointing a tier at a different provider is a config change, never a
# code change.
#
#   reasoning  -> JD extraction (FR2) + Matched/Weak/Gap classification (FR7-FR9)
#   generation -> rewrite suggestions (FR10) + interview-prep questions (FR21-FR23)
#
# Default setup is free end to end: Gemini free tier for reasoning, local
# Ollama for generation.


# ============================================================
# 1. REASONING TIER  -- Google Gemini (free tier)
# ============================================================
# Get a free key: https://aistudio.google.com/apikey
# This is the only credential you need to run the core pipeline.
GOOGLE_API_KEY=

# GEMINI_API_KEY is accepted as an alias if you copied it under that name.
# GEMINI_API_KEY=

# Which Gemini model. Defaults are set from measured behaviour on a real free
# tier account (docs/providers.md). VERIFY AGAINST YOUR OWN ACCOUNT before a
# long run -- availability differs per account and a wrong ID fails at call
# time, not at import:
#     python scripts/check_providers.py --live
#
# Measured free-tier quotas (this is what decides the default, not quality):
#   gemini-3.5-flash-lite   15 req/min, large daily allowance   <- default
#   gemini-3.5-flash         5 req/min AND ONLY 20 PER DAY -- one JD run
#                            exhausts the day. Unusable here.
#   gemini-3.6/3.7-flash     same 5/min cap; 3.7 also very slow
#   gemini-*-pro             429 immediately: no usable free Pro quota
#   gemini-2.5-pro / 2.5-flash   404: withdrawn for new accounts
# REQONCILE_REASONING_PROVIDER=google
# REQONCILE_REASONING_MODEL=gemini-3.5-flash-lite

# 0.0 = deterministic. Keep it there: the classifier eval (T036) is only
# meaningful if repeated runs on the same input agree. Note some models
# (e.g. gemini-3.6-flash) ignore this and sample at fixed defaults.
# REQONCILE_REASONING_TEMPERATURE=0.0


# ============================================================
# 2. GENERATION TIER  -- Ollama (local, no key, permanently free)
# ============================================================
# Install:  https://ollama.com/download
# Then:     ollama pull llama3:8b     (or:  ollama pull mistral:7b)
# Ollama must be running for rewrite generation to work.
# REQONCILE_GENERATION_PROVIDER=ollama
# REQONCILE_GENERATION_MODEL=llama3:8b
# OLLAMA_BASE_URL=http://localhost:11434

# Slightly above 0 so rewrites don't read stilted. The no-fabrication
# constraint (R2) is enforced by the grounding check at T043, not by sampling.
# REQONCILE_GENERATION_TEMPERATURE=0.2


# ============================================================
# 3. SWAPPING TIERS
# ============================================================
# Any tier can point at any provider: google | ollama | anthropic.
#
# Run everything locally (fully offline, weaker classification):
#   REQONCILE_REASONING_PROVIDER=ollama
#   REQONCILE_REASONING_MODEL=llama3:8b
#
# Move rewrites to the hosted tier (if local output disappoints):
#   REQONCILE_GENERATION_PROVIDER=google
#   REQONCILE_GENERATION_MODEL=gemini-2.5-flash
#
# ANTHROPIC_API_KEY=


# ============================================================
# 4. SHARED LLM SETTINGS
# ============================================================
# Concurrency for the classification fan-out (T034). Kept low because the
# Gemini free tier caps requests per minute -- raising this is the fastest way
# to start collecting 429s. Revisit at T052 with real latency numbers.
# REQONCILE_LLM_MAX_CONCURRENCY=4
# Client-side pace limit per model, requests/min. Must not exceed the model's
# real quota -- the API rejects excess rather than queueing it.
# REQONCILE_LLM_RPM=15

# REQONCILE_LLM_MAX_TOKENS=4096
# REQONCILE_LLM_TIMEOUT_S=90
# REQONCILE_LLM_MAX_RETRIES=3


# ============================================================
# 5. RETRIEVAL + PATHS  (local, no credentials)
# ============================================================
# Embeddings run locally via sentence-transformers -- no API cost either way.
# REQONCILE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# REQONCILE_TOP_K=5
# REQONCILE_CHUNK_MIN_CHARS=25

# REQONCILE_CHROMA_PATH=./.chroma
# REQONCILE_LOG_PATH=./logs/runs.jsonl
